---
import Social from "@/components/actionable/Social.astro";
import FooterLink from "./FooterLink.astro";
import FooterLogo from "./FooterLogo.astro";
---

<footer class="bg-dark-jungle px-4 pt-28 pb-6">
  <div class="mx-auto max-w-250">
    <!-- Top -->
    <div class="mb-14 flex flex-col gap-6 md:flex-row md:justify-between">
      <div>
        <FooterLogo />
      </div>
      <div>
        <ul class="flex flex-col gap-4">
          <FooterLink href="#hero-section">Home</FooterLink>
          <FooterLink href="#projects-section">Projects</FooterLink>
          <FooterLink href="#contact-section">Contact</FooterLink>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="text-chalk-canvas font-sans text-lg font-semibold">
          Connect with me
        </h3>
        <Social />
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-t-[#FDFBF7]/10 pt-8">
      <p
        class="text-center font-sans text-sm font-normal text-white/70 md:text-left"
      >
        © Copyright Haroun Achouche 2026
      </p>
    </div>
  </div>
</footer>
