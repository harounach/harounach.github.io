---
import Social from "@components/actionable/Social.astro";
import FooterLink from "./FooterLink.astro";
import FooterLogo from "./FooterLogo.astro";
---

<footer class="px-4 md:px-6">
  <!-- Top -->
  <div class="mx-auto max-w-250 py-22 md:py-28">
    <div class="flex flex-col gap-6 md:flex-row md:justify-between">
      <div>
        <FooterLogo />
      </div>
      <div>
        <ul class="flex flex-col gap-4">
          <FooterLink href="/">Home</FooterLink>
          <FooterLink href="/projects">Projects</FooterLink>
          <FooterLink href="/blog">Blog</FooterLink>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="font-sans text-lg font-semibold">Connect with me</h3>
        <Social />
      </div>
    </div>
  </div>
  <!-- Bottom -->
  <div class="mx-auto max-w-250 py-2.5">
    <p class="text-center font-sans text-sm font-normal text-neutral-600">
      © Copyright Haroun Achouche 2026
    </p>
  </div>
</footer>
