---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<li>
  <a
    href={href}
    title={title}
    class="hover:bg-pea bg-confetti flex h-10 w-10 items-center justify-center rounded-full text-black no-underline transition will-change-auto hover:text-white"
  >
    <slot />
    <span class="sr-only">{title}</span>
  </a>
</li>
