---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
---

<li>
  <a
    href={url}
    title={title}
    class="hover:bg-pea-800 flex h-10 w-10 items-center justify-center rounded-full text-black no-underline transition will-change-auto hover:text-white"
  >
    <slot />
    <span class="sr-only">{title}</span>
  </a>
</li>
