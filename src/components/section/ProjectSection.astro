---
import ProjectCard from "@/components/section/ProjectCard.astro";
import { latestProjects } from "@/lib/data";
---

<section
  class="bg-platinum-silk scroll-mt-20 px-4 py-22 md:px-6 md:py-28"
  aria-labelledby="projects-heading"
  id="projects-section"
>
  <div class="mx-auto max-w-250">
    <div class="flex flex-col gap-14">
      <h2
        id="projects-heading"
        class="text-deep-charcoal text-center font-sans text-[1.75rem] font-semibold md:text-[2rem]"
      >
        Just a taste of what I have done
      </h2>
      <div class="grid grid-cols-1 gap-14 md:grid-cols-3">
        {latestProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </div>
</section>
