---
import { Image } from "astro:assets";
import type { TProject } from "src/types/types";

interface Props {
  project: TProject;
}

const { project } = Astro.props;
---

<div
  class="relative isolate flex flex-col gap-5 rounded-lg px-2 pt-1 pb-4 hover:bg-zinc-50"
>
  <Image
    src={project.imageUrl}
    alt={project.imageAlt}
    width={370}
    height={278}
    class="block h-auto w-full max-w-92.5 rounded-lg"
  />
  <a href={project.url} class="font-sans text-xl font-semibold">
    <span class="absolute inset-0 z-10"></span>
    {project.title}
  </a>
  <p class="font-sans text-base leading-relaxed font-normal text-neutral-700">
    {project.description}
  </p>
</div>
