---
import { Image } from "astro:assets";
import type { TProject } from "src/types/types";

interface Props {
  project: TProject;
}

const { project } = Astro.props;
---

<div
  class="hover:bg-chalk-canvas relative isolate flex flex-col gap-7 rounded-lg px-2 pt-2 pb-4 transition-colors"
>
  <!-- Thumbnail -->
  <div>
    <Image
      src={project.imageUrl}
      alt={project.imageAlt}
      width={370}
      height={278}
      class="block h-auto max-w-full rounded-lg"
    />
  </div>

  <!-- Card Meta -->
  <div class="flex flex-col gap-3">
    <a
      href={project.url}
      class="text-deep-charcoal font-sans text-xl font-semibold"
    >
      <span class="absolute inset-0 z-10"></span>
      {project.title}
    </a>
    <p
      class="text-muted-charcoal font-sans text-base leading-relaxed font-normal"
    >
      {project.description}
    </p>
  </div>
</div>
