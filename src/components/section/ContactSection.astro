---
import MailIcon from "@assets/icons/mail.svg";
---

<section id="contact-section" class="bg-[#FAFAFA] px-4 py-22 md:px-6 md:py-28">
  <div class="mx-auto max-w-250">
    <div
      class="bg-confetti-300 mx-auto flex flex-col items-center gap-6 rounded-lg px-6 py-12 text-black md:max-w-190 md:py-14"
    >
      <h2
        class="text-center font-sans text-[28px] font-semibold md:text-[32px]"
      >
        Let’ work together
      </h2>
      <p
        class="text-center font-sans text-lg leading-relaxed font-normal md:max-w-115"
      >
        Have a project in mind? Let’s work together. Reach out via email or my
        social accounts to discuss how we can bring your ideas to life.
      </p>
      <a
        href="mailto:harounach7@gmail.com"
        class="flex items-center gap-2 px-4 py-3 font-sans text-xl font-medium"
        ><MailIcon /> harounach7@gmail.com</a
      >
    </div>
  </div>
</section>
