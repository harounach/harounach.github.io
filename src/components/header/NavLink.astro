---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  className?: string;
}

const { className, ...attrs } = Astro.props;
---

<li>
  <a
    class="hover:text-pea-800 px-4 py-2.5 font-sans text-base font-medium transition md:p-0"
    {...attrs}><slot /></a
  >
</li>
