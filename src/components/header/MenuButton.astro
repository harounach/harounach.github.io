<button
  id="menu-btn"
  class="group relative z-40 flex h-10 w-10 shrink-0 cursor-pointer flex-col justify-between border-0 bg-transparent p-2 md:hidden"
  aria-label="Menu button"
  role="menubar"
>
  <span
    class="h-1 w-full rounded-sm bg-black transition group-[.menu-open]:translate-y-2.5 group-[.menu-open]:rotate-45"
  ></span>
  <span
    class="h-1 w-full rounded-sm bg-black transition group-[.menu-open]:opacity-0"
  ></span>
  <span
    class="h-1 w-full rounded-sm bg-black transition group-[.menu-open]:-translate-y-2.5 group-[.menu-open]:-rotate-45"
  ></span>
</button>
