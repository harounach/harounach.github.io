---
import Logo from "./Logo.astro";
import NavLink from "./NavLink.astro";
import Button from "@components/actionable/Button.astro";
import MenuButton from "./MenuButton.astro";

const { className } = Astro.props;
---

<header class:list={["px-4 py-3 md:px-6", className]}>
  <a href="#content" class="sr-only focus:not-sr-only">Skip to content</a>
  <div class="mx-auto max-w-300">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <Logo />
      <div>
        <nav class="flex items-center gap-10">
          <ul class="flex items-center justify-center gap-6">
            <NavLink href="/">Home</NavLink>
            <NavLink href="/projects">Projects</NavLink>
            <NavLink href="/blog">Blog</NavLink>
          </ul>
          <Button href="#contact-section">Contact</Button>
        </nav>
      </div>

      <!-- Menu button (Mobile only) -->
      <MenuButton />
    </div>
  </div>
</header>
