---
import Logo from "./Logo.astro";
import NavLink from "./NavLink.astro";
---

<header
  class="bg-chalk-canvas fixed top-0 left-0 z-50 flex h-20 w-full items-center border-b border-b-[#1A2421]/10"
>
  <a href="#content" class="sr-only focus:not-sr-only">Skip to content</a>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4">
    <!-- Logo Left -->
    <Logo />

    <!-- Hamburger Button (Mobile Only) -->
    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 p-2 md:hidden"
      aria-label="Toggle Menu"
      aria-expanded="false"
    >
      <span
        class="bg-deep-charcoal line-1 h-0.5 w-6 origin-left transition-all duration-300"
      ></span>
      <span
        class="bg-deep-charcoal line-2 h-0.5 w-6 transition-all duration-300"
      ></span>
      <span
        class="bg-deep-charcoal line-3 h-0.5 w-6 origin-left transition-all duration-300"
      ></span>
    </button>

    <!-- Nav Links & CTA Panel -->
    <nav
      id="nav-menu"
      class="bg-chalk-canvas absolute top-20 left-0 hidden w-full flex-col gap-6 border-b border-b-[#1A2421]/10 p-6 shadow-md transition-all duration-300 md:static md:flex md:w-auto md:flex-row md:items-center md:border-none md:p-0 md:shadow-none"
    >
      <ul class="flex flex-col gap-4 md:flex-row md:items-center md:gap-4">
        <NavLink href="#hero-section">Home</NavLink>
        <NavLink href="#projects-section">Projects</NavLink>
      </ul>
      <a
        href="#contact-section"
        class="font-title a bg-pea hover:bg-pea/75 inline-flex shrink-0 cursor-pointer items-center justify-center rounded-lg px-4 py-2.5 text-base font-medium text-white transition"
        >Contact</a
      >
    </nav>
  </div>
</header>
