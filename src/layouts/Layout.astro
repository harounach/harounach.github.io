---
interface Props {
  pageTitle: string;
  metaDescription: string;
  metaKeyWords: string;
  className?: string;
}

import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "@/components/header/Header.astro";
import Footer from "@/components/footer/Footer.astro";
import BackButton from "@/components/actionable/BackButton.astro";
import Meta from "./Meta.astro";
const { pageTitle, metaDescription, metaKeyWords, className } = Astro.props;
---

<!doctype html>
<html lang="en" class="scrollbar-thin scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeyWords} />
    <Font cssVariable="--font-inter" />
    <Meta />
  </head>
  <body class:list={["pt-20 font-sans", className]}>
    <!-- The Sentinel: When this leaves the top, the header is "scrolled" -->
    <div
      id="header-sentinel"
      class="pointer-events-none absolute top-0 h-px w-full"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <BackButton />

    <script>
      import { initApp } from "@/scripts/octopus";

      document.addEventListener("DOMContentLoaded", () => {
        initApp();
      });
    </script>
  </body>
</html>
